{
  "name": "cocoaair",
  "version": "1.0.0",
  "description": "Send files, photos and text between any devices, over the same Wi-Fi or across the internet with a room code.",
  "main": "electron/main.cjs",
  "author": "CocoaSuite",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "productName": "CocoaAir",
  "homepage": "https://github.com/CocoaSuite/CocoaAir",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.1",
    "preact": "^11.2.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  },
  "build": {
    "appId": "com.cocoasuite.cocoaair",
    "productName": "CocoaAir",
    "copyright": "Copyright © CocoaSuite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CocoaAir",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "maintainer": "CocoaSuite"
    },
    "publish": null
  }
}
